{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "portfolio monorepo orchestrator",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './apps/*' run build",
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "dev:backend": "pnpm --filter @portfolio/backend dev",
    "dev:frontend": "pnpm --filter @portfolio/frontend dev",
    "dev:drawnguess": "pnpm --filter @portfolio/drawnguess dev",
    "lint": "pnpm -r --filter './apps/*' run lint",
    "type-check": "pnpm -r --filter './apps/*' run type-check"
  }
}
